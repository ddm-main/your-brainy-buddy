{
  "name": "jarvis-hud",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=23.6.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 8080",
    "dev:api": "PORT=3960 HUD_HOST=127.0.0.1 node Apps/hud/server.mjs",
    "relay": "node --env-file=.env Apps/relay/kotak-ws-relay.mjs",
    "shoonya:proxy": "node --env-file=.env Apps/relay/shoonya-proxy.mjs",
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "preview": "vite preview --host 0.0.0.0 --port 8080",
    "start": "vite --host 0.0.0.0 --port 8080",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts,.tsx",
    "format": "prettier --write .",
    "test": "vitest run"
  },
  "dependencies": {
    "@react-three/fiber": "^8.17.10",
    "@supabase/supabase-js": "^2.110.8",
    "@tanstack/react-query": "^5.62.0",
    "@tanstack/react-table": "^8.21.3",
    "clsx": "^2.1.1",
    "framer-motion": "^11.11.17",
    "lightweight-charts": "^5.2.0",
    "lucide-react": "^0.469.0",
    "papaparse": "^5.5.4",
    "pdfjs-dist": "4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.2",
    "tailwind-merge": "^2.5.5",
    "three": "^0.170.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^3.23.0",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.1",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.170.0",
    "@vitejs/plugin-react": "^6.0.3",
    "concurrently": "^9.1.0",
    "eslint": "^10.6.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.5",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.63.0",
    "vite": "8.2.1",
    "vitest": "^4.1.10"
  }
}
