# Copy this file to `.env` (gitignored) at the repo root before `npm run dev`.
# Fill in YOUR project's real values below — do not commit real credentials
# to this file. Find them in the Supabase dashboard → Project Settings → API.

# ── Frontend (Vite) — REQUIRED to run the app ──────────────────────────────
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=<publishable-anon-key>
VITE_SUPABASE_PROJECT_ID=<project-ref>

# Optional: user id of the workspace owner. The Admin Users screen uses this
# to lock delete/role changes on the owner row. Defaults to the original
# hardcoded id if unset.
VITE_OWNER_USER_ID=


# ── Supabase MCP server (Claude Code only — optional) ──────────────────────
# Only needed if you want the `supabase` MCP server in Claude Code to run
# /sync against the database. Generate a personal access token at:
#   https://supabase.com/dashboard/account/tokens
SUPABASE_PROJECT_REF=<project-ref>
SUPABASE_ACCESS_TOKEN=

# ── Kotak WS relay (`npm run relay`) — SERVER-ONLY, never VITE_-prefixed ───
# These give the local relay process the same privileged access edge
# functions have: bypass RLS to read the Kotak session, and decrypt it.
# NEVER commit real values. NEVER expose these to the browser bundle.
#
# Service role key: Supabase dashboard → Project Settings → API → service_role.
SUPABASE_SERVICE_ROLE_KEY=
# Must match the edge-function secret of the same name exactly
# (`supabase secrets list` to check, `supabase secrets set STATEMENT_ENC_SECRET=...`
# to set/rotate — rotating breaks decryption of anything already encrypted with
# the old value, so only do this deliberately).
STATEMENT_ENC_SECRET=
