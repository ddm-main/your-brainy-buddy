# Copy this file to `.env` (gitignored) at the repo root before `npm run dev`.
# Fill in YOUR project's real values below — do not commit real credentials
# to this file. Find them in the Supabase dashboard → Project Settings → API.

# ── Frontend (Vite) — REQUIRED to run the app ──────────────────────────────
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=<publishable-anon-key>
VITE_SUPABASE_PROJECT_ID=<project-ref>

# ── Supabase MCP server (Claude Code only — optional) ──────────────────────
# Only needed if you want the `supabase` MCP server in Claude Code to run
# /sync against the database. Generate a personal access token at:
#   https://supabase.com/dashboard/account/tokens
SUPABASE_PROJECT_REF=<project-ref>
SUPABASE_ACCESS_TOKEN=
