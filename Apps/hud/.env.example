# Copy to .env (gitignored). Server-side only — never expose the service role key to a browser.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
# PORT=3960

# Gmail (Recent Mail panel — read, reply, delete, mark read/unread). Create an
# OAuth client at https://console.cloud.google.com → APIs & Services →
# Credentials (type: Web application, redirect URI:
# http://localhost:3960/api/gmail/callback) and enable the Gmail API. Then
# click "Connect Gmail" on the HUD.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# JARVIS voice brain (optional — falls back to a canned offline responder if unset)
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# Encrypts bank/card statement passwords at rest (AES-256-GCM via node:crypto).
# Set a long random value in your real .env — never leave the default.
STATEMENT_ENC_SECRET=
